---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import { useTranslations } from "@/i18n/utils";

// 404 wird ohne Sprachkontext ausgeliefert – Standard: Englisch
const lang = "en";
const t = useTranslations(lang);
---

<Layout title={t.notFound.title} description={t.notFound.desc} lang={lang}>
  <Container>
    <div class="py-32 text-center">
      <p class="text-7xl font-bold text-night-200">404</p>
      <h1 class="mt-4 text-3xl font-bold text-night-950">{t.notFound.title}</h1>
      <p class="mt-3 text-lg text-slate-600">{t.notFound.desc}</p>
      <a
        href="/en/"
        class="mt-8 inline-block rounded-lg bg-accent-500 px-6 py-3 font-semibold text-night-950 transition hover:bg-accent-400">
        {t.notFound.home}
      </a>
    </div>
  </Container>
</Layout>
