---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Cta from "@/components/cta.astro";
import { localePath, useLang, useTranslations } from "@/i18n/utils";
import { splitEntryId, getServices, entryKey } from "@/i18n/content";

export async function getStaticPaths() {
  const entries = await getCollection("services");
  return entries.map((entry) => {
    const { lang, key } = splitEntryId(entry.id);
    return { params: { lang, slug: key }, props: { entry } };
  });
}

const { entry } = Astro.props;
const lang = useLang(Astro.params.lang);
const t = useTranslations(lang);
const { Content } = await entry.render();

const otherServices = (await getServices(lang)).filter(
  (s) => entryKey(s) !== entryKey(entry),
);
---

<Layout title={entry.data.title} description={entry.data.summary} lang={lang}>
  <section class="bg-night-950">
    <Container>
      <div class="max-w-3xl py-16 md:py-20">
        <p
          class="flex items-center gap-3 text-sm font-semibold uppercase tracking-[0.2em] text-accent-400">
          <span class="h-px w-8 bg-accent-400"></span>
          {t.services.kicker}
        </p>
        <h1 class="mt-4 text-3xl font-bold tracking-tight text-white lg:text-5xl">
          {entry.data.title}
        </h1>
        <p class="mt-4 text-lg text-night-200">{entry.data.summary}</p>
      </div>
    </Container>
  </section>

  <Container>
    <div class="mx-auto mt-12 grid max-w-5xl gap-12 lg:grid-cols-[2fr_1fr]">
      <div>
        <div class="overflow-hidden">
          <Picture
            src={entry.data.cover}
            alt={entry.data.title}
            widths={[800, 1400]}
            sizes="(max-width: 1024px) 100vw, 800px"
            format="avif"
            class="aspect-[16/9] w-full object-cover"
          />
        </div>
        <div
          class="prose prose-slate mt-10 max-w-none prose-headings:text-night-950">
          <Content />
        </div>
      </div>

      <aside class="space-y-6">
        <div class="border border-night-100 bg-night-50 p-6">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500">
            {t.services.otherServices}
          </h2>
          <ul class="mt-4 space-y-3">
            {
              otherServices.map((s) => (
                <li>
                  <a
                    href={localePath(lang, `/services/${entryKey(s)}`)}
                    class="group flex items-center gap-3 text-sm font-medium text-night-800 hover:text-night-950">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center bg-accent-600">
                      <Icon name={s.data.icon} class="h-4 w-4 text-white" />
                    </span>
                    {s.data.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="bg-night-900 p-6 text-center">
          <p class="font-semibold text-white">{t.cta.title}</p>
          <a
            href={localePath(lang, "/contact")}
            class="mt-4 inline-block w-full bg-accent-500 px-5 py-2.5 font-semibold text-white transition hover:bg-accent-400">
            {t.cta.button}
          </a>
        </div>
      </aside>
    </div>
  </Container>

  <div class="mt-20">
    <Cta lang={lang} />
  </div>
</Layout>
