---
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar.astro";
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/oswald";
import "../styles/global.css";
import { site } from "@/config/site";
import type { Lang } from "@/i18n/ui";
import { htmlLang, langs, switchLangPath } from "@/i18n/utils";

export interface Props {
  title: string;
  description: string;
  lang: Lang;
}

const { title, description, lang } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL("/opengraph.jpg", Astro.site).toString();

const alternates = langs.map((l) => ({
  hrefLang: htmlLang[l],
  href: new URL(switchLangPath(Astro.url.pathname, l), Astro.site).toString(),
}));
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(switchLangPath(Astro.url.pathname, "en"), Astro.site).toString()}
    />
    <SEO
      title={title}
      titleTemplate={`%s | ${site.name}`}
      titleDefault={site.name}
      description={description}
      canonical={canonicalURL}
      languageAlternates={alternates}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: `${title} | ${site.name}`,
          image: ogImage,
        },
        image: {
          alt: site.name,
        },
      }}
    />
  </head>
  <body class="bg-white text-night-950 antialiased">
    <Navbar lang={lang} />
    <slot />
    <Footer lang={lang} />
  </body>
</html>
