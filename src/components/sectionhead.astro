---
interface Props {
  kicker?: string;
  title: string;
  desc?: string;
  align?: "left" | "center";
}

const { kicker, title, desc, align = "center" } = Astro.props;
---

<div class:list={["max-w-2xl", align === "center" ? "mx-auto text-center" : ""]}>
  {
    kicker && (
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent-600">
        {kicker}
      </p>
    )
  }
  <h2 class="mt-3 text-3xl font-bold tracking-tight text-night-950 lg:text-4xl">
    {title}
  </h2>
  {desc && <p class="mt-4 text-lg text-slate-600">{desc}</p>}
</div>
