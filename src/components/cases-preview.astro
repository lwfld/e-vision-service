---
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import CaseCard from "@/components/case-card.astro";
import { Icon } from "astro-icon/components";
import type { Lang } from "@/i18n/ui";
import { localePath, useTranslations } from "@/i18n/utils";
import { getCases } from "@/i18n/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const cases = (await getCases(lang)).slice(0, 3);
---

<section class="bg-night-50 py-24">
  <Container>
    <Sectionhead kicker={t.cases.kicker} title={t.cases.title} desc={t.cases.desc} />
    <div class="mt-16 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {cases.map((entry) => <CaseCard lang={lang} entry={entry} />)}
    </div>
    <div class="mt-12 text-center">
      <a
        href={localePath(lang, "/cases")}
        class="inline-flex items-center gap-2 font-semibold text-accent-600 hover:text-accent-500">
        {t.cases.all}
        <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </Container>
</section>
