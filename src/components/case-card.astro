---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { Lang } from "@/i18n/ui";
import { localePath } from "@/i18n/utils";
import { entryKey } from "@/i18n/content";

interface Props {
  lang: Lang;
  entry: CollectionEntry<"cases">;
}

const { lang, entry } = Astro.props;
---

<a
  href={localePath(lang, `/cases/${entryKey(entry)}`)}
  class="group flex flex-col overflow-hidden border border-night-100 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
  <div class="relative aspect-[16/10] overflow-hidden">
    <Picture
      src={entry.data.cover}
      alt={entry.data.title}
      widths={[400, 800]}
      sizes="(max-width: 640px) 100vw, 400px"
      format="avif"
      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
    />
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p>
      <span
        class="inline-block bg-accent-600 px-2 py-1 text-[10px] font-semibold uppercase tracking-wider text-white">
        {entry.data.sector}
      </span>
    </p>
    <h3 class="mt-2 text-lg font-semibold text-night-950">{entry.data.title}</h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">
      {entry.data.summary}
    </p>
  </div>
</a>
