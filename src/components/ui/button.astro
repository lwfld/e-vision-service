---
interface Props {
  size?: "md" | "lg";
  block?: boolean;
  style?: "outline" | "primary" | "inverted";
  class?: string;
  [x: string]: any;
}

const {
  size = "md",
  style = "primary",
  block,
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  md: "px-5 py-2.5",
  lg: "px-6 py-3",
};

const styles = {
  outline:
    "border-2 border-night-950 hover:bg-night-950 text-night-950 hover:text-white",
  primary:
    "bg-accent-600 text-white font-semibold hover:bg-accent-500 border-2 border-transparent",
  inverted:
    "border-2 border-white/40 text-white hover:border-white hover:bg-white/10",
};
---

<button
  {...rest}
  class:list={[
    "text-center transition focus-visible:ring-2 ring-offset-2 ring-accent-500",
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
  ><slot />
</button>
